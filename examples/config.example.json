{
  "_comment": "Example task configuration for parsing a product listing",

  "name": "Books To Scrape — All Books",
  "url": "https://books.toscrape.com/",
  "engine": "static",

  "selectors": {
    "item": "article.product_pod",
    "fields": {
      "title": {
        "selector": "h3 a",
        "selectorType": "css",
        "attr": "title",
        "transform": ["trim"]
      },
      "price": {
        "selector": "p.price_color",
        "attr": null,
        "transform": ["trim", "number"]
      },
      "rating": {
        "selector": "p.star-rating",
        "attr": "class",
        "transform": ["trim", "regex:star-rating (\\w+):1"]
      },
      "availability": {
        "selector": "p.availability",
        "attr": null,
        "transform": ["trim", "lowercase"]
      },
      "link": {
        "selector": "h3 a",
        "attr": "href",
        "transform": null
      },
      "image": {
        "selector": "img.thumbnail",
        "attr": "src"
      }
    }
  },

  "pagination": {
    "enabled": true,
    "type": "next-button",
    "selector": "li.next a",
    "maxPages": 50
  },

  "schedule": {
    "enabled": false,
    "cron": "0 6 * * *"
  },

  "proxy": {
    "enabled": false,
    "rotate": true
  },

  "options": {
    "timeout": 30000,
    "retries": 3,
    "delay": 800,
    "antiBot": true,
    "headers": {}
  },

  "tags": ["books", "ecommerce", "demo"]
}
