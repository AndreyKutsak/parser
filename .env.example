# ============================================================
# Web Parser Pro — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/webparser

# Redis (for BullMQ queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-very-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Playwright (dynamic engine) — env var names kept as PUPPETEER_* for backward compatibility
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# Anti-bot delays (ms)
MIN_DELAY=500
MAX_DELAY=2000

# Default proxy check URL
PROXY_CHECK_URL=https://httpbin.org/ip

# Parser defaults
DEFAULT_TIMEOUT=30000
DEFAULT_RETRIES=3
MAX_CONCURRENT_TASKS=5
